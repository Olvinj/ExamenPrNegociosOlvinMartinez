<?xml version="1.0" encoding="utf-8"?>
<odoo>

<menuitem
    id="menu_unicah_biblioteca_root"
    name="UNICAH Biblioteca"
    sequence="50"
/>

    
    <record id="view_biblioteca_categoria_list" model="ir.ui.view">
        <field name="name">unicah.biblioteca.categoria.list</field>
        <field name="model">unicah.biblioteca.categoria</field>
        <field name="arch" type="xml">
            <list string="Categorías de libros">
                <field name="name"/>
                <field name="descripcion"/>
                <field name="cantidad_libros"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    
    <record id="view_biblioteca_categoria_form" model="ir.ui.view">
        <field name="name">unicah.biblioteca.categoria.form</field>
        <field name="model">unicah.biblioteca.categoria</field>
        <field name="arch" type="xml">
            <form string="Categoría de libros">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="descripcion"/>
                        <field name="active"/>
                        <field name="cantidad_libros" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Libros">
                            <field name="libro_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="autor"/>
                                    <field name="isbn"/>
                                    <field name="existencias"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="action_biblioteca_categoria" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">unicah.biblioteca.categoria</field>
        <field name="view_mode">list,form</field>
    </record>

    
    <menuitem
        id="menu_biblioteca_categoria"
        name="Categorías"
        parent="menu_unicah_biblioteca_root"
        action="action_biblioteca_categoria"
        sequence="20"
    />

</odoo>
